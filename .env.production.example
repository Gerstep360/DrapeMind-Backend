# =====================================================================
# DRAPEMIND - CONFIGURACION DE PRODUCCION PARA SERVIDOR LINUX (VPS)
# IP Servidor: 157.173.102.129
# Prefijo de servicio: /DrapeMind
# =====================================================================

# Aplicacion
APP_NAME="DrapeMind API"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
API_V1_PREFIX="/api/v1"
ROOT_PATH="/DrapeMind"
DOCS_ENABLED=true
PORT=8045

# Seguridad (El script install.sh los autogenera automaticamente)
# Para generarlos manualmente: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="CAMBIAR_POR_TOKEN_ALEATORIO_DE_MINIMO_32_CARACTERES"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de datos PostgreSQL aislada (No afecta otras DBs del servidor)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="drapemind_user"
POSTGRES_PASSWORD="CAMBIAR_POR_CONTRASENA_SEGURA"
POSTGRES_DB="drapemind_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
# Conexión separada, con NOSUPERUSER y NOBYPASSRLS; distinta del dueño de tablas.
RUNTIME_DATABASE_URL=
SAAS_WEB_URL="https://TU_DOMINIO/DrapeMind"
STRIPE_SAAS_WEBHOOK_SECRET=""
# El endpoint de reenvío local queda deshabilitado en production.
STRIPE_LOCAL_WEBHOOK_SECRET=""

# CORS: Solo permite el dominio/IP del frontend y desarrollo local
CORS_ORIGINS='["http://157.173.102.129","http://157.173.102.129:80","http://localhost","http://127.0.0.1"]'
CORS_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true

AI_TIMEOUT_SECONDS=90
AI_MAX_TOKENS=1024
AI_AGENT_DEADLINE_SECONDS=180
AI_TEMPERATURE=0.35

# Presupuesto de respuesta visible; el orquestador suma el razonamiento intacto.
# Contadores exactos por sección consultan /tokenize; desactivado por defecto.

# Dominio y Pagos
RESERVATION_TTL_MINUTES=2880
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="CAMBIAR_POR_SECRET_ALEATORIO_DE_MINIMO_24_CARACTERES"
AR_ASSET_BASE_URL="http://157.173.102.129/DrapeMind/static/ar"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"
NVIDIA_API_KEY=""
NVIDIA_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'
AI_MAX_TOOL_ROUNDS=3
AI_MAX_TOOL_CALLS=8
