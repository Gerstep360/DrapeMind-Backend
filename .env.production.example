# =====================================================================
# DRAPEMIND - CONFIGURACION DE PRODUCCION PARA SERVIDOR LINUX (VPS)
# IP Servidor: 157.173.102.129
# Prefijo de servicio: /DrapeMind
# =====================================================================

# Aplicacion
APP_NAME="DrapeMind API"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
API_V1_PREFIX="/api/v1"
ROOT_PATH="/DrapeMind"
DOCS_ENABLED=true
PORT=8045

# Seguridad (El script install.sh los autogenera automaticamente)
# Para generarlos manualmente: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="CAMBIAR_POR_TOKEN_ALEATORIO_DE_MINIMO_32_CARACTERES"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de datos PostgreSQL aislada (No afecta otras DBs del servidor)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="drapemind_user"
POSTGRES_PASSWORD="CAMBIAR_POR_CONTRASENA_SEGURA"
POSTGRES_DB="drapemind_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# CORS: Solo permite el dominio/IP del frontend y desarrollo local
CORS_ORIGINS='["http://157.173.102.129","http://157.173.102.129:80","http://localhost","http://127.0.0.1"]'
CORS_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true

# Gemma 4 / llama-server local administrado por FastAPI (Puerto seguro 8088 para evitar 8080)
AI_BASE_URL="http://127.0.0.1:8088/v1"
AI_API_KEY="local-no-key"
AI_MODEL="google/gemma-4-E2B-it-qat-q4_0-gguf"
AI_MANAGED_SERVER=true
AI_SERVER_HOST="127.0.0.1"
AI_SERVER_PORT=8088
AI_MODEL_PATH="ai_models/gemma-4-e2b/gemma-4-E2B_q4_0-it.gguf"
AI_MMPROJ_PATH="ai_models/gemma-4-e2b/gemma-4-E2B-it-mmproj.gguf"
LLAMA_SERVER_PATH="/usr/local/bin/llama-server"
AI_IDLE_TIMEOUT_SECONDS=600
AI_STARTUP_TIMEOUT_SECONDS=240
AI_CONTEXT_SIZE=8192
AI_PARALLEL_SLOTS=2
AI_THREADS=0
AI_GPU_LAYERS="0"
AI_SERVER_EXTRA_ARGS=""
AI_MAX_AGENT_STEPS=4
AI_TIMEOUT_SECONDS=90
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.35

# Dominio y Pagos
RESERVATION_TTL_MINUTES=2880
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="CAMBIAR_POR_SECRET_ALEATORIO_DE_MINIMO_24_CARACTERES"
AR_ASSET_BASE_URL="http://157.173.102.129/DrapeMind/static/ar"
