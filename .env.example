# Aplicacion
APP_NAME="DrapeMind API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
DOCS_ENABLED=true
PORT=8000

NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_API_KEY=""
NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"
# Opciones del modelo candidato; quitar o adaptar al cambiar de modelo.
NVIDIA_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'
AI_MAX_TOOL_ROUNDS=3
AI_MAX_TOOL_CALLS=8
# Políticas reales configuradas por la tienda. Vacío = información no disponible.
STORE_POLICIES='{}'

# Seguridad: generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-with-at-least-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL. DATABASE_URL tiene prioridad si se define.
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/drapemind_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="drapemind_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
RUNTIME_DATABASE_URL=
SAAS_WEB_URL="http://localhost:4200"
STRIPE_SAAS_WEBHOOK_SECRET=""
STRIPE_LOCAL_WEBHOOK_SECRET=""

# Angular web. JSON estricto y sin slash final. Flutter nativo no requiere CORS.
CORS_ORIGINS='["http://localhost:4200","http://127.0.0.1:4200"]'
CORS_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true

# Absolute deadline per model decision; HTTP timeout remains an inactivity timeout.
AI_AGENT_DEADLINE_SECONDS=180
AI_TURN_TIMEOUT_SECONDS=150
AI_TIMEOUT_SECONDS=90
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.35

# Compatibilidad anterior, deshabilitada en el panel local y al usar NVIDIA.
# Presupuesto de respuesta visible; el orquestador suma el razonamiento intacto.
# Contadores exactos por sección consultan /tokenize; desactivado por defecto.

# Dominio
RESERVATION_TTL_MINUTES=2880
PAYMENT_PROVIDER="mock"
# Set provider=stripe only after configuring keys for the same Stripe account/mode.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMENT_WEBHOOK_SECRET="change-me-payment-webhook-secret"
AR_ASSET_BASE_URL="http://localhost:8000/static/ar"
