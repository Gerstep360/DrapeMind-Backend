# Aplicacion
APP_NAME="DrapeMind API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
DOCS_ENABLED=true

# Seguridad: generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-with-at-least-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL. DATABASE_URL tiene prioridad si se define.
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/drapemind_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="drapemind_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Angular web. JSON estricto y sin slash final. Flutter nativo no requiere CORS.
CORS_ORIGINS='["http://localhost:4200","http://127.0.0.1:4200"]'
CORS_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true

# llama.cpp / LM Studio / vLLM con API OpenAI-compatible
AI_BASE_URL="http://localhost:8080/v1"
AI_API_KEY="local-no-key"
AI_MODEL="google/gemma-4-E2B-it-qat-q4_0-gguf"
AI_MANAGED_SERVER=true
AI_SERVER_HOST="127.0.0.1"
AI_SERVER_PORT=8080
AI_MODEL_PATH="ai_models/gemma-4-e2b/gemma-4-E2B_q4_0-it.gguf"
AI_MMPROJ_PATH="ai_models/gemma-4-e2b/gemma-4-E2B-it-mmproj.gguf"
# Windows puede omitirlo si existe vendor/llama.cpp/llama-server.exe.
# Linux/VPS: LLAMA_SERVER_PATH="/usr/local/bin/llama-server"
LLAMA_SERVER_PATH=
AI_IDLE_TIMEOUT_SECONDS=600
AI_STARTUP_TIMEOUT_SECONDS=240
AI_CONTEXT_SIZE=8192
AI_PARALLEL_SLOTS=2
AI_THREADS=0
AI_GPU_LAYERS="auto"
AI_SERVER_EXTRA_ARGS=""
AI_MAX_AGENT_STEPS=4
AI_TIMEOUT_SECONDS=90
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.35

# Dominio
RESERVATION_TTL_MINUTES=2880
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="change-me-payment-webhook-secret"
AR_ASSET_BASE_URL="http://localhost:8000/static/ar"
